# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Render provides this automatically)
DATABASE_URL="postgresql://user:password@localhost:5432/livefittingroom?schema=public"

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Security ──────────────────────────────────────────────────────────────────
# Strong secret for signing JWT session tokens — generate with: openssl rand -hex 64
JWT_SECRET="replace-with-a-long-random-secret-64-chars-minimum"

# Used to hash/verify partner API keys
BCRYPT_ROUNDS=12

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed in development (production uses per-partner DB config)
DEV_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3001"

# ─── Digitcan Internal ─────────────────────────────────────────────────────────
# Master admin key for creating/managing partners via the partner management API
DIGITCAN_ADMIN_KEY="replace-with-admin-secret"

# Measurement engine version (updated when algorithm changes)
MEASUREMENT_ENGINE_VERSION="1.0.0"
